# DocuSense settings. Copy to .env (project) or ~/.docusense/.env (per user).
# With nothing set, DocuSense uses embedded SQLite + files under ~/.docusense.

# Postgres + pgvector instead of SQLite (`docker compose up -d`, install docusense-mcp[postgres]):
# DOCUSENSE_DATABASE_URL=postgresql://docusense:docusense@localhost:5433/docusense
# DOCUSENSE_STORE_DIR=store
# DOCUSENSE_HOME=~/.docusense

DOCUSENSE_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional LLM fallback for extraction / contradiction judging (off unless --llm-fallback / --llm-judge).
# DOCUSENSE_LLM_PROVIDER=auto        # auto | groq | anthropic | openai | ollama | openai-compatible
# DOCUSENSE_LLM_MODEL=               # anthropic default: claude-opus-5-5; required for openai/ollama
# DOCUSENSE_LLM_BASE_URL=            # ollama / openai-compatible endpoints
GROQ_API_KEY=
DOCUSENSE_EXTRACT_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=                 # needs: pip install 'docusense-mcp[anthropic]'
# OPENAI_API_KEY=

# Benchmark agent.
OPENROUTER_API_KEY=
DOCUSENSE_AGENT_PROVIDER=openrouter
DOCUSENSE_AGENT_MODEL=google/gemma-4-31b-it:free
DOCUSENSE_AGENT_MAX_TOOL_CALLS=15
DOCUSENSE_AGENT_MAX_TOKENS=60000
